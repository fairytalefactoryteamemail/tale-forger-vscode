{
  "for loop": {
    "prefix": "for",
    "body": "for (int ${1:i} = ${2:0}; ${1:i} < ${3:10};) {\n\t${0}\n}",
    "description": "For loop with auto-step"
  },
  "for loop with step": {
    "prefix": "fors",
    "body": "for (int ${1:i} = ${2:0}; ${1:i} < ${3:10}; step ${4:1}) {\n\t${0}\n}",
    "description": "For loop with manual step"
  },
